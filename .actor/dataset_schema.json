{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "actorSpecification": 1,
    "title": "Dataset Schema",
    "fields": {
        "type": "object",
        "properties": {
            "recordSource": {
                "title": "Record Source",
                "type": "string",
                "description": "fda_enforcement or ema_dhpc - which regulator feed produced this record"
            },
            "record_id": {
                "title": "Record ID",
                "type": "string",
                "description": "Stable, source-prefixed id (fda:<recall_number> or ema:<slug>:<dissemination_date>) - unique within this actor's own record space"
            },
            "event_type": {
                "title": "Event Type",
                "type": "string",
                "description": "First seen: SANCTION (FDA recall/enforcement classification) or NEW_LISTING (EMA newly published safety communication). On a repeat sighting of an already-known record: STATUS_CHANGE (FDA status, or EMA regulatory_outcome, differs from last time this actor saw it), UPDATED (some other tracked field differs but status/outcome did not), or SNAPSHOT_NO_DIFF (identical to the last time it was seen). No CLOSED event - neither source is known to remove historical records, and this actor's bounded newest-first fetch does not attempt a complete-census walk of either register."
            },
            "scraped_at": { "title": "Scraped At", "type": "string", "description": "ISO-8601 timestamp of this extraction" },
            "is_new": {
                "title": "Is New",
                "type": ["boolean", "null"],
                "description": "true if not seen in a prior run (delta mode, this actor's own key-value store)"
            },
            "source_url": { "title": "Source URL", "type": ["string", "null"] },
            "recipient_or_defendant_name": {
                "title": "Recipient or Defendant Name",
                "type": ["string", "null"],
                "description": "FDA: recalling_firm. EMA: name_of_medicine (no marketing-authorisation-holder/company field exists in the DHPC feed, so the medicine itself is the named subject - never guessed)."
            },
            "entity_identifier_native": {
                "title": "Entity Identifier (native)",
                "type": ["string", "null"],
                "description": "FDA: event_id. EMA: atc_code_human (WHO ATC classification code)."
            },
            "value_native": { "title": "Value (native)", "type": ["string", "null"], "description": "Always null - neither source carries a monetary value field" },
            "value_currency": { "title": "Value Currency", "type": ["string", "null"], "description": "Always null" },
            "value_usd_normalized": { "title": "Value (USD normalized)", "type": ["number", "null"], "description": "Always null" },
            "effective_date_iso": {
                "title": "Effective Date (ISO)",
                "type": ["string", "null"],
                "description": "FDA: recall_initiation_date. EMA: dissemination_date."
            },
            "publish_date_iso": {
                "title": "Publish Date (ISO)",
                "type": ["string", "null"],
                "description": "FDA: report_date. EMA: first_published_date."
            },
            "category_or_type": {
                "title": "Category or Type",
                "type": ["string", "null"],
                "description": "FDA: product_type. EMA: dhpc_type."
            },
            "status_or_estado": {
                "title": "Status",
                "type": ["string", "null"],
                "description": "FDA: status (Ongoing/Terminated/Completed). EMA: regulatory_outcome (often empty -> null)."
            },
            "awarding_or_regulating_agency": { "title": "Regulating Agency", "type": ["string", "null"] },
            "jurisdiction": { "title": "Jurisdiction", "type": "string", "description": "US or EU" },
            "source_document_url": {
                "title": "Source Document URL",
                "type": ["string", "null"],
                "description": "Always null for both sources - neither feed exposes a separate per-record document/PDF URL distinct from source_url"
            },
            "reference_number": {
                "title": "Reference Number",
                "type": ["string", "null"],
                "description": "FDA: recall_number. EMA: procedure_number (often empty -> null)."
            },
            "regulatoryDataDisclaimer": {
                "title": "Regulatory Data Disclaimer",
                "type": "string",
                "description": "Mandatory, non-removable on every record: states the data is sourced directly from the named regulator's own public feed, is not independently medically verified by this actor, and is not intended as clinical or consumer medical advice."
            },
            "classification": { "title": "FDA Classification", "type": ["string", "null"], "description": "FDA only: Class I/II/III severity tier" },
            "productDescription": { "title": "Product Description", "type": ["string", "null"], "description": "FDA only" },
            "reasonForRecall": { "title": "Reason For Recall", "type": ["string", "null"], "description": "FDA only" },
            "recallingFirm": { "title": "Recalling Firm", "type": ["string", "null"], "description": "FDA only" },
            "distributionPattern": { "title": "Distribution Pattern", "type": ["string", "null"], "description": "FDA only" },
            "voluntaryMandated": { "title": "Voluntary or Mandated", "type": ["string", "null"], "description": "FDA only" },
            "recallNumber": { "title": "Recall Number", "type": ["string", "null"], "description": "FDA only" },
            "eventId": { "title": "FDA Event ID", "type": ["string", "null"], "description": "FDA only" },
            "city": { "title": "City", "type": ["string", "null"], "description": "FDA only" },
            "state": { "title": "State", "type": ["string", "null"], "description": "FDA only" },
            "country": { "title": "Country", "type": ["string", "null"], "description": "FDA only" },
            "nameOfMedicine": { "title": "Name of Medicine", "type": ["string", "null"], "description": "EMA only" },
            "activeSubstances": { "title": "Active Substances", "type": ["string", "null"], "description": "EMA only" },
            "dhpcType": { "title": "DHPC Type", "type": ["string", "null"], "description": "EMA only" },
            "atcCodeHuman": { "title": "ATC Code (human)", "type": ["string", "null"], "description": "EMA only" },
            "therapeuticAreaMesh": { "title": "Therapeutic Area (MeSH)", "type": ["string", "null"], "description": "EMA only" },
            "procedureNumber": { "title": "Procedure Number", "type": ["string", "null"], "description": "EMA only" },
            "regulatoryOutcome": { "title": "Regulatory Outcome", "type": ["string", "null"], "description": "EMA only" }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "recordSource",
                    "record_id",
                    "event_type",
                    "recipient_or_defendant_name",
                    "category_or_type",
                    "status_or_estado",
                    "awarding_or_regulating_agency",
                    "jurisdiction",
                    "effective_date_iso",
                    "reference_number",
                    "regulatoryDataDisclaimer"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "Source", "format": "text", "field": "recordSource" },
                    { "label": "Record ID", "format": "text", "field": "record_id" },
                    { "label": "Event Type", "format": "text", "field": "event_type" },
                    { "label": "Subject", "format": "text", "field": "recipient_or_defendant_name" },
                    { "label": "Category/Type", "format": "text", "field": "category_or_type" },
                    { "label": "Status", "format": "text", "field": "status_or_estado" },
                    { "label": "Agency", "format": "text", "field": "awarding_or_regulating_agency" },
                    { "label": "Jurisdiction", "format": "text", "field": "jurisdiction" },
                    { "label": "Effective Date", "format": "text", "field": "effective_date_iso" },
                    { "label": "Reference #", "format": "text", "field": "reference_number" }
                ]
            }
        },
        "changes": {
            "title": "Change detection",
            "transformation": {
                "fields": ["recordSource", "record_id", "event_type", "status_or_estado", "scraped_at", "is_new"]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "Source", "format": "text", "field": "recordSource" },
                    { "label": "Record ID", "format": "text", "field": "record_id" },
                    { "label": "Event", "format": "text", "field": "event_type" },
                    { "label": "Status", "format": "text", "field": "status_or_estado" },
                    { "label": "Scraped At", "format": "date", "field": "scraped_at" },
                    { "label": "Is New", "format": "boolean", "field": "is_new" }
                ]
            }
        }
    }
}
